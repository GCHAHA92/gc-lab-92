---
import { getCollection } from 'astro:content';
import DesktopPage from '../../layouts/DesktopPage.astro';
import Hero from '../../components/Hero.astro';
import { sitePath } from '../../lib/paths';

const notes = (await getCollection('notes', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

const nav = [
  { label: '← Home', path: '' },
  { label: 'Tools', path: 'tools/' },
  { label: 'Changelog', path: 'changelog/' },
  { label: 'Guestbook', path: 'guestbook/' },
];

const formatDate = (date: Date) => new Intl.DateTimeFormat('ko-KR', {
  year: 'numeric', month: '2-digit', day: '2-digit', timeZone: 'Asia/Seoul',
}).format(date);
---

<DesktopPage
  pageTitle="NOTES | 임시 사이트"
  description="임시 사이트의 개발 기록과 메모"
  windowTitle="NOTES.EXE"
  windowIcon="assets/icons/notebook.svg"
  taskTitle="NOTES.EXE"
  taskIcon="assets/icons/notebook.svg"
  nav={nav}
>
  <Hero
    eyebrow="★ NOTES / IDEAS / LOGS ★"
    title="NOTES"
    lines={['개발 과정과 다음 아이디어를', '짧게 쌓아두는 메모장입니다.']}
  />
  {notes.length > 0 ? (
    <section class="page-panel">
      <h2>▣ SAVED NOTES</h2>
      <div class="note-list">
        {notes.map((note) => (
          <a class="note-entry" href={sitePath(`notes/${note.id}/`)}>
            <time datetime={note.data.publishedAt.toISOString()}>{formatDate(note.data.publishedAt)}</time>
            <div><h3>{note.data.title}</h3><p>{note.data.description}</p></div>
            <span class="note-entry-tags">{note.data.tags.join(' · ')}</span>
          </a>
        ))}
      </div>
    </section>
  ) : (
    <section class="page-panel note-empty">
      <strong>새 메모를 준비하고 있습니다.</strong>
      <p>완성된 글보다 만드는 과정부터 천천히 기록할 예정입니다.</p>
    </section>
  )}
  <div class="terminal"><b>C:\임시_사이트\NOTES&gt;</b> {notes.length > 0 ? `${notes.length}개의 메모를 불러왔습니다.` : '첫 번째 메모를 기다리는 중...'} <span class="cursor"></span></div>
</DesktopPage>
