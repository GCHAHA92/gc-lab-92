---
import DesktopPage from '../layouts/DesktopPage.astro';
import Hero from '../components/Hero.astro';
import ToolCard from '../components/ToolCard.astro';
import { tools } from '../data/tools';
import { sitePath } from '../lib/paths';

const nav = [
  { label: 'Home', path: '' },
  { label: 'Tools', path: 'tools/' },
  { label: 'Notes', path: 'notes/' },
  { label: 'About', path: 'about/' },
  { label: 'Guestbook', path: 'guestbook/' },
];

const shortcuts = [
  { label: 'MY_TOOLS', image: 'assets/icons/folder.svg', path: 'tools/' },
  { label: '새올', image: 'assets/images/saeol.ico', message: '새올행정시스템 바로가기입니다.' },
  { label: 'ABOUT_ME', image: 'assets/icons/computer.svg', path: 'about/' },
  { label: 'NOTES', image: 'assets/icons/notebook.svg', path: 'notes/' },
  { label: '방명록', image: 'assets/icons/guestbook.svg', path: 'guestbook/' },
  { label: 'TRASH', image: 'assets/icons/trash.svg', message: '삭제된 아이디어도 언젠가 부활할 수 있습니다.' },
];
---

<DesktopPage
  pageTitle="임시 사이트"
  description="반복되는 업무를 조금 편하게 만드는 작업실"
  windowTitle="임시_사이트.EXE"
  taskTitle="임시_사이트.EXE"
  nav={nav}
  shortcuts={shortcuts}
  closeMessage="작업은 종료되지 않습니다."
  startMessage="원하는 폴더를 열어보세요."
>
  <Hero
    eyebrow="NONBISA.COM · PERSONAL LAB"
    title="임시 사이트"
    lines={['반복되는 업무를 조금 편하게 만드는', '엑셀기반 도구와 개인 기록장']}
    mascot={sitePath('assets/images/geumcheon-hankki-logo.png')}
  />
  <div class="section-head"><h2>▣ INSTALLED TOOLS</h2><p><span class="blink">●</span> SYSTEM ONLINE</p></div>
  <section class="tool-grid">
    {tools.map((tool) => <ToolCard tool={tool} href={tool.href ? sitePath(tool.href) : undefined} />)}
  </section>
  <nav class="pager" id="pager" aria-label="도구 목록 페이지" hidden>
    <button id="prevPage" type="button" aria-label="이전 도구 4개">&lt;</button>
    <strong class="page-label" id="pageLabel">1 / 1</strong>
    <button id="nextPage" type="button" aria-label="다음 도구 4개">&gt;</button>
  </nav>
  <div class="terminal"><b>C:\임시_사이트&gt;</b> 새로운 생각을 실행 가능한 무언가로 만드는 중... <span class="cursor"></span></div>
</DesktopPage>
