---
import type { ToolItem } from '../data/tools';

interface Props {
  tool: ToolItem;
  href?: string;
}

const { tool, href } = Astro.props;
---

{href ? (
  <a class="tool-card" href={href}>
    <span class="tool-icon" aria-hidden="true">{tool.icon}</span>
    <div><h3>{tool.title}</h3><p>{tool.description}</p></div>
    <span class:list={["status", tool.statusType]}>{tool.status}</span>
  </a>
) : (
  <article class="tool-card pending" tabindex="0" data-message={tool.message}>
    <span class="tool-icon" aria-hidden="true">{tool.icon}</span>
    <div><h3>{tool.title}</h3><p>{tool.description}</p></div>
    <span class:list={["status", tool.statusType]}>{tool.status}</span>
  </article>
)}
