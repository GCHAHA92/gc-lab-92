---
import { sitePath } from '../lib/paths';
import '../styles/astro.css';

interface NavItem {
  label: string;
  path: string;
}

interface Shortcut {
  label: string;
  icon?: string;
  image?: string;
  path?: string;
  message?: string;
}

const defaultShortcuts: Shortcut[] = [
  { label: 'HOME', image: 'assets/icons/computer.svg', path: '' },
  { label: 'MY_TOOLS', image: 'assets/icons/folder.svg', path: 'tools/' },
  { label: 'NOTES', image: 'assets/icons/notebook.svg', path: 'notes/' },
  { label: '방명록', image: 'assets/icons/guestbook.svg', path: 'guestbook/' },
  { label: 'TRASH', image: 'assets/icons/trash.svg', message: '삭제된 아이디어... 언젠가 부활할 수 있습니다.' },
];

interface Props {
  pageTitle: string;
  description: string;
  windowTitle: string;
  windowIcon?: string;
  taskTitle: string;
  taskIcon?: string;
  nav?: NavItem[];
  shortcuts?: Shortcut[];
  closeMessage?: string;
  startMessage?: string;
}

const {
  pageTitle,
  description,
  windowTitle,
  windowIcon = 'assets/icons/computer.svg',
  taskTitle,
  taskIcon = 'assets/icons/computer.svg',
  nav = [],
  shortcuts = defaultShortcuts,
  closeMessage,
  startMessage,
} = Astro.props;

const stylesheet = sitePath('assets/css/site.css');
const desktopStylesheet = sitePath('assets/css/desktop.css');
const siteScript = sitePath('assets/js/site.js');
const analyticsScript = sitePath('assets/js/analytics.js');
const home = sitePath();
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const isPrimarySite = Astro.site?.hostname === 'nonbisa.com';
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="theme-color" content="#123a35" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary" />
    <title>{pageTitle}</title>
    <link rel="stylesheet" href={desktopStylesheet} />
    <link rel="stylesheet" href={stylesheet} />
    {isPrimarySite && (
      <script
        is:inline
        async
        src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-3535288587120077"
        crossorigin="anonymous"
      ></script>
    )}
    <slot name="head" />
  </head>
  <body>
    <div class="desktop">
      {shortcuts.length > 0 && (
        <aside class="gc-shell-shortcuts" aria-label="바탕화면 바로가기">
          {shortcuts.map((shortcut) => shortcut.path ? (
            <a class="gc-shell-shortcut" href={sitePath(shortcut.path)}>
              <span class="gc-shell-shortcut-icon">
                {shortcut.image ? <img src={sitePath(shortcut.image)} alt="" /> : shortcut.icon}
              </span>
              <span>{shortcut.label}</span>
            </a>
          ) : (
            <button class="gc-shell-shortcut" type="button" data-message={shortcut.message}>
              <span class="gc-shell-shortcut-icon">
                {shortcut.image ? <img src={sitePath(shortcut.image)} alt="" /> : shortcut.icon}
              </span>
              <span>{shortcut.label}</span>
            </button>
          ))}
        </aside>
      )}

      <main class="window" id="mainWindow">
        <div class="titlebar">
          <span class="titlebar-name"><img class="window-icon" src={sitePath(windowIcon)} alt="" />{windowTitle}</span>
          <div class="controls">
            <button class="control" id="minBtn" type="button" aria-label="최소화">_</button>
            <button class="control" id="maxBtn" type="button" aria-label="최대화">□</button>
            {closeMessage ? (
              <button class="control" type="button" data-message={closeMessage} aria-label="닫기">×</button>
            ) : (
              <a class="control control-link" href={home} aria-label="닫기">×</a>
            )}
          </div>
        </div>
        <nav class="menubar" aria-label="주 메뉴">
          {nav.map((item) => <a href={sitePath(item.path)}>{item.label}</a>)}
        </nav>
        <div class="window-body">
          <slot />
          <footer class="site-policy-links" aria-label="사이트 정책 및 문의">
            <a href={sitePath('privacy/')}>개인정보처리방침</a>
            <span aria-hidden="true">·</span>
            <a href={sitePath('contact/')}>문의</a>
          </footer>
        </div>
      </main>
    </div>

    <div class="taskbar">
      {startMessage ? (
        <button class="start" type="button" data-message={startMessage}>▣ START</button>
      ) : (
        <a class="start start-link" href={home}>▣ START</a>
      )}
      <div class="task"><img class="task-icon" src={sitePath(taskIcon)} alt="" />{taskTitle}</div>
      <div class="clock" id="clock">00:00</div>
    </div>
    <div class="toast" id="toast" role="status"></div>
    <script is:inline src={analyticsScript}></script>
    <script is:inline src={siteScript}></script>
  </body>
</html>
